# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=change_me_to_a_long_random_string
JWT_SECRET=change_me_to_a_different_long_random_string

# 42 OAuth (register app at https://profile.intra.42.fr/oauth/applications)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the intra
FORTYTWO_CALLBACK_URL=http://localhost:3000/api/auth/42/callback

# Supabase (use the SERVICE ROLE key here, never the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"